{
  "name": "ai-subs",
  "version": "0.4.0",
  "private": true,
  "description": "AI Subs — universal supplier hisobi, xavfsiz mock fulfillment va sinov wallet",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "supplier:check": "node --env-file-if-exists=.env scripts/check-supplier.js",
    "fx:check": "node scripts/check-fx.js",
    "test:supplier": "node --test tests/supplier-*.test.js",
    "fulfillment:keygen": "node scripts/generate-fulfillment-key.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^8.19.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3"
  }
}
