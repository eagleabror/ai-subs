TELEGRAM_BOT_TOKEN=
MONGODB_URI=mongodb://127.0.0.1:27017/ai-subs?replicaSet=rs0
LIGHTSTORE_API_KEY=
LIGHTSTORE_API_BASE_URL=https://api.light-store.net/api/v1
ADMIN_TELEGRAM_ID=
AUTO_PURCHASE_ENABLED=false
PORT=3000
LIGHTSTORE_TIMEOUT_MS=10000

# CBU: 1 RUB = Rate / Nominal UZS. Auto rejimda RUB_TO_UZS_RATE kerak emas.
FX_RATE_MODE=auto
FX_CBU_URL=https://cbu.uz/uz/arkhiv-kursov-valyut/json/
FX_REFRESH_INTERVAL_MINUTES=360
FX_MAX_AGE_DAYS=7
FX_MAX_FETCH_AGE_HOURS=48
FX_TIMEOUT_MS=10000
FX_COST_BUFFER_PERCENT=0
# Eski sozlama mosligi: FX_RATE_MODE berilmaganida bir marta legacy kurs sifatida import qilinadi.
RUB_TO_UZS_RATE=
DEFAULT_MARKUP_PERCENT=20
ROUNDING_INCREMENT_UZS=1000
MARKUP_MIN_PERCENT=0
MARKUP_MAX_PERCENT=1000
# Faqat eski sozlamalarni bir martalik import uchun. Individual ustamalarni /admin orqali saqlang.
PRODUCT_MARKUP_OVERRIDE={}

# Phase 4: faqat quote/fulfillment ma'lumotlarini shifrlash uchun 32 baytli base64 kalit.
# Yo'q bo'lsa supplier input/quote/delivery o'chadi; oldingi katalog/wallet ishlaydi.
# Kalitni lokal generator bilan yarating, git yoki chatga yubormang. Xaridni yoqmaydi.
FULFILLMENT_ENCRYPTION_KEY=
